cabal-version:   3.0
name:            Parser
version:         0.1.0.0
license:         BSD-2-Clause
license-file:    LICENSE
maintainer:      lanovaya.al6@gmail.com
author:          ALanovaya
build-type:      Simple
extra-doc-files: CHANGELOG.md

library
    exposed-modules:
        AST
        Parser

    hs-source-dirs:     src
    default-language:   Haskell2010
    default-extensions: OverloadedStrings LambdaCase
    ghc-options:        -Wall
    build-depends:
        base >=4.14 && <5,
        megaparsec >= 9,
        text,
        containers,
        mtl,
        transformers,
        parser-combinators

test-suite Parser-test
    type:               exitcode-stdio-1.0
    main-is:            ParserTest.hs
    hs-source-dirs:     test
    default-language:   Haskell2010
    default-extensions: OverloadedStrings LambdaCase
    ghc-options:        -Wall
    build-depends:
        base >=4.14 && <5,
        HUnit ^>=1.6,
        Parser,
        megaparsec,
        text,
        containers,
        mtl,
        transformers,
        hspec,
        QuickCheck
